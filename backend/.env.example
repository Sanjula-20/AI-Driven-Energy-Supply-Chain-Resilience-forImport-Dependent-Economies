# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:   mongodb://127.0.0.1:27017/energyshield
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/energyshield
MONGO_URI=mongodb://127.0.0.1:27017/energyshield

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Seed defaults (used only by seed script to create demo accounts)
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ANALYST_PASSWORD=Analyst@12345
SEED_VIEWER_PASSWORD=Viewer@12345
